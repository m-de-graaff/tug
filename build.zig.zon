.{
    .name = .tug,
    .version = "0.1.0-dev",
    .fingerprint = 0x2d2760d670499822, // Changing this has security and trust implications.

    // Pinned deliberately, not aspirationally. Zig's std is still moving, and a
    // harness whose build breaks on a toolchain bump is a harness nobody
    // trusts. See docs/decisions/DR-001-toolchain-pin.md for the upgrade
    // policy: bumping this is a changelog event, never a surprise.
    .minimum_zig_version = "0.16.0",

    // v0.1 ships zero third-party dependencies. The one candidate — a TOML
    // parser — is decided in Phase 7 and vendored either way, because a build
    // that fetches from the network is a build that can fail for reasons that
    // have nothing to do with the code.
    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "scripts",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "README.md",
    },
}
