# Shell scripts are LF in the working tree on every platform, not just in the
# object store. `core.autocrlf=true` is the Windows default, and a script
# checked out with CRLF fails on its own `set -eu` line — which is why
# `scripts/exit-paths.sh` could not be run from the machine tug is developed on
# until Phase 3.
*.sh text eol=lf

# Zig sources for the same reason, one step earlier: `zig fmt --check` reports
# every CRLF file as needing reformatting, which buries a real formatting
# problem in a list of every file in the repo.
*.zig text eol=lf

# Golden transcripts are compared byte for byte against what the renderer
# emitted, so a CRLF checkout would fail every one of them on Windows.
testdata/golden/*.txt text eol=lf

# TOML for the third variant of the same bug: the two built-in themes are
# `@embedFile`d and parsed byte for byte, so a CRLF checkout would put a `\r`
# on the end of every value and turn every colour into a `bad_color` warning.
*.toml text eol=lf

# `build.zig.zon` is a Zig source `zig fmt` also checks. It is not matched by
# `*.zig`, and a CRLF copy of it makes a whole-tree `zig fmt --check` red on
# Windows for a reason that has nothing to do with the code.
*.zon text eol=lf

# Response fixtures are byte-exact recordings, and one of the things the SSE
# parser is tested against is CRLF framing. A checkout that rewrote line endings
# in either direction would silently change what the tests assert, so git is told
# not to touch them at all.
testdata/fixtures/** -text
